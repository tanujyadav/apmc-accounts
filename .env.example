# Replace with your permanent PostgreSQL database connection.
# Never share the real password publicly.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Login credentials for the accounts app. Change these before deploying —
# do not keep the sample values.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-to-a-strong-password

# Random secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this later logs everyone out.
AUTH_SECRET=replace-with-a-long-random-string
